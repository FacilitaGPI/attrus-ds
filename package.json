{
  "name": "@attrus-ds/core",
  "version": "1.3.0",
  "description": "ATTRUS / Cabiros design system — design tokens, component styles, brand assets, fonts and an optional typed React component layer.",
  "keywords": [
    "design-system",
    "design-tokens",
    "attrus",
    "cabiros",
    "css",
    "tokens",
    "fonts",
    "fintech"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FacilitaGPI/attrus-ds.git"
  },
  "homepage": "https://github.com/FacilitaGPI/attrus-ds#readme",
  "bugs": {
    "url": "https://github.com/FacilitaGPI/attrus-ds/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/css/index.css",
    "./css": "./dist/css/index.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./tokens.json": "./dist/tokens/attrus-tokens.json",
    "./tokens.flat.json": "./dist/tokens/attrus-tokens.flat.json",
    "./themes": "./dist/css/themes/index.css",
    "./themes/*": "./dist/css/themes/*",
    "./components/*": "./dist/css/components/*",
    "./react": "./dist/react/index.ts",
    "./react/*": "./dist/react/*",
    "./assets/*": "./dist/assets/*",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/lato": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
